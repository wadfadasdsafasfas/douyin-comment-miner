{
  "name": "tingchao-desktop",
  "productName": "听潮",
  "version": "1.0.1",
  "description": "听潮 TideSignal · 多平台评论监控与线索挖掘",
  "author": "层峰科技",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.cengfeng.tingchao",
    "productName": "听潮",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist-sidecar/tingchao-sidecar",
        "to": "sidecar/tingchao-sidecar"
      }
    ],
    "asar": true,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "TingChao-macos-v${version}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": false,
        "NSMicrophoneUsageDescription": "本应用不使用麦克风"
      }
    },
    "dmg": {
      "artifactName": "TingChao-macos-v${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "TingChao-windows-v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "听潮",
      "artifactName": "TingChao-windows-v${version}-setup.exe"
    },
    "afterSign": "scripts/adhoc-sign.js"
  }
}
